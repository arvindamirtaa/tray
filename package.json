{
  "name": "tray",
  "version": "1.0.0",
  "description": "Durable, auditable agent workflows",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "cleanup": "tsx --env-file=.env src/tools/cleanup-sandboxes.ts",
    "dev": "tsx --env-file=.env src/server.ts --dev",
    "smoke:agent": "tsx --env-file=.env src/tools/smoke-agent.ts",
    "smoke:daytona": "tsx --env-file=.env src/tools/smoke-daytona.ts",
    "smoke:eventlog": "tsx --env-file=.env src/tools/smoke-eventlog.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "test:fixture": "cd fixture && python3 -m unittest -v",
    "typecheck": "tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@daytona/sdk": "^0.200.1",
    "@heroicons/react": "^2.2.0",
    "braintrust": "^3.24.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  }
}
